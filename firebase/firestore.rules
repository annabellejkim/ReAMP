rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /check_ins/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if request.auth != null;
    }

    match /users/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if request.auth != null;
    }
  }
}
